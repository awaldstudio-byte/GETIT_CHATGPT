{
  "version": "7.3",
  "screens": [
    {
      "id": "SHOP_APPLICATION",
      "title": "Getit - Add a shop",
      "terminal": true,
      "success": true,
      "data": {},
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "Add your shop to Getit"
          },
          {
            "type": "TextBody",
            "text": "Tell us about your Villiers shop. Your application will go to the Getit team for review."
          },
          {
            "type": "Form",
            "name": "form",
            "children": [
              {
                "type": "TextInput",
                "name": "applicant_name",
                "label": "Your full name",
                "input-type": "text",
                "required": true,
                "max-chars": 100
              },
              {
                "type": "TextInput",
                "name": "business_name",
                "label": "Shop name",
                "input-type": "text",
                "required": true,
                "max-chars": 120
              },
              {
                "type": "Dropdown",
                "name": "business_type",
                "label": "Main business type",
                "required": true,
                "data-source": [
                  { "id": "grocery_general", "title": "Grocery / supermarket / general dealer" },
                  { "id": "convenience_spaza", "title": "Convenience / spaza" },
                  { "id": "butchery_fresh_food", "title": "Butchery / fresh food" },
                  { "id": "bakery_takeaway", "title": "Bakery / restaurant / takeaway" },
                  { "id": "pharmacy_health_beauty", "title": "Pharmacy / health / beauty" },
                  { "id": "hardware_agri_garden", "title": "Hardware / building / agri / garden" },
                  { "id": "veterinary_pet", "title": "Veterinary / pet supplies" },
                  { "id": "clothing_homeware", "title": "Clothing / footwear / homeware" },
                  { "id": "automotive_electronics", "title": "Automotive / electronics / appliances" },
                  { "id": "licensed_restricted", "title": "Licensed liquor / tobacco" },
                  { "id": "other", "title": "Other" }
                ]
              },
              {
                "type": "TextArea",
                "name": "location_text",
                "label": "Villiers address",
                "helper-text": "Type the shop's full street address",
                "required": true,
                "max-length": 500
              },
              {
                "type": "TextCaption",
                "text": "Submitting sends this application to Getit for review. It does not make the shop live. Privacy: awaldstudio.com/getit-privacy-policy"
              },
              {
                "type": "Footer",
                "label": "Send to Getit",
                "on-click-action": {
                  "name": "complete",
                  "payload": {
                    "application_type": "shop",
                    "applicant_name": "${form.applicant_name}",
                    "business_name": "${form.business_name}",
                    "business_type": "${form.business_type}",
                    "location_text": "${form.location_text}"
                  }
                }
              }
            ]
          }
        ]
      }
    }
  ]
}
