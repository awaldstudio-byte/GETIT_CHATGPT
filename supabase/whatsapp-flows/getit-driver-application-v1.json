{
  "version": "7.3",
  "screens": [
    {
      "id": "DRIVER_APPLICATION",
      "title": "Getit - Driver form",
      "terminal": true,
      "success": true,
      "data": {},
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "Apply to deliver with Getit"
          },
          {
            "type": "TextBody",
            "text": "Getit is still launching. You need your own working motorbike, and applying does not guarantee work."
          },
          {
            "type": "Form",
            "name": "form",
            "children": [
              {
                "type": "TextInput",
                "name": "applicant_name",
                "label": "Your full name",
                "input-type": "text",
                "required": true,
                "max-chars": 100
              },
              {
                "type": "TextInput",
                "name": "location_text",
                "label": "Your Villiers area",
                "input-type": "text",
                "required": true,
                "max-chars": 120
              },
              {
                "type": "TextArea",
                "name": "availability",
                "label": "When can you work?",
                "helper-text": "Example: weekdays, evenings or weekends",
                "required": true,
                "max-length": 300
              },
              {
                "type": "OptIn",
                "name": "has_own_bike",
                "label": "I have my own working motorbike.",
                "required": true
              },
              {
                "type": "OptIn",
                "name": "launch_ack",
                "label": "I understand that Getit is still launching and work is not guaranteed.",
                "required": true
              },
              {
                "type": "TextCaption",
                "text": "Submitting sends this application to Getit for review. Privacy: awaldstudio.com/getit-privacy-policy"
              },
              {
                "type": "Footer",
                "label": "Send to Getit",
                "on-click-action": {
                  "name": "complete",
                  "payload": {
                    "application_type": "driver",
                    "applicant_name": "${form.applicant_name}",
                    "location_text": "${form.location_text}",
                    "availability": "${form.availability}",
                    "has_own_bike": "${form.has_own_bike}",
                    "launch_ack": "${form.launch_ack}"
                  }
                }
              }
            ]
          }
        ]
      }
    }
  ]
}
